{
  "name": "website",
  "license": "AGPL-3.0-only",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "husky",
    "format": "yarn lint-staged",
    "build:front": "yarn workspace frontend build",
    "build:back": "yarn workspace cms build",
    "build": "yarn && yarn build:front && yarn build:cms",
    "check:front": "yarn workspace frontend check",
    "dev:front": "yarn workspace frontend dev",
    "dev:back": "yarn workspace cms dev",
    "preview:front": "yarn workspace frontend preview",
    "test:front": "yarn workspace frontend test:ci-no-pool && yarn workspace frontend test:integration",
    "test-ci:front": "yarn workspace frontend test:ci-no-pool && yarn workspace frontend test:integration",
    "test-ci:back": "yarn workspace cms test-ci:unit",
    "test-coverage": "yarn vitest run --coverage",
    "front:test:ui": "yarn workspace frontend test:ui",
    "sanity": "yarn workspace cms sanity",
    "sync-types": "yarn workspace cms sanity:typegen && yarn workspace frontend sanity typegen generate",
    "lint:front": "yarn run -T eslint packages/frontend",
    "lint:cms": "yarn run -T eslint packages/cms"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@sanity/eslint-config-studio": "^7.0.0",
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript/native": "npm:typescript@7",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "micromatch": "^4.0.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.0",
    "svelte-language-server": "0.18.4",
    "tslib": "^2.8.1",
    "typescript": "~6",
    "typescript-svelte-plugin": "0.3.52",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  },
  "packageManager": "yarn@4.14.1",
  "engines": {
    "node": "26.8.1"
  }
}
