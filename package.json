{
  "name": "website",
  "license": "AGPL-3.0-only",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "husky",
    "format": "yarn lint-staged",
    "build:front": "yarn workspace frontend build",
    "build:back": "yarn workspace cms build",
    "build": "yarn && yarn build:front && yarn build:cms",
    "check:front": "yarn workspace frontend check",
    "dev:front": "yarn workspace frontend dev",
    "dev:back": "yarn workspace cms dev",
    "preview:front": "yarn workspace frontend preview",
    "test:front": "yarn workspace frontend test:ci-no-pool && yarn workspace frontend test:integration",
    "test-ci:front": "yarn workspace frontend test:ci-no-pool && yarn workspace frontend test:integration",
    "test-ci:back": "yarn workspace cms test-ci:unit",
    "test-coverage": "yarn vitest run --coverage",
    "front:test:ui": "yarn workspace frontend test:ui",
    "sanity": "yarn workspace cms sanity",
    "sync-types": "yarn workspace cms sanity:typegen && yarn workspace frontend sanity typegen generate",
    "lint:front": "yarn run -T eslint packages/frontend",
    "lint:cms": "yarn run -T eslint packages/cms"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "styled-components": "^6.3.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/compat": "2.0.5",
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^4.1.3",
    "@vitest/ui": "^4.1.3",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "micromatch": "^4.0.8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.55.2",
    "svelte-language-server": "0.17.30",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "typescript-svelte-plugin": "0.3.51",
    "vite": "^8.0.7",
    "vitest": "^4.1.3",
    "wrangler": "^4.81.0"
  },
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": "25.6.1"
  }
}
