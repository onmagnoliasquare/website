{
  "name": "cms",
  "main": "package.json",
  "type": "module",
  "version": "0.8.4",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "preview": "wrangler dev dist",
    "build": "sanity build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "run -T vitest",
    "ci:test:unit": "run -T vitest run",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "copy-prod-to-dev": "npx sanity dataset export production ./prod_data.tar.gz && npx sanity dataset delete development && npx sanity dataset create development && npx sanity dataset import ./prod_data.tar.gz development --replace",
    "sanity:typegen": "yarn sanity schema extract && yarn sanity typegen generate"
  },
  "dependencies": {
    "@sanity/cross-dataset-duplicator": "2.1.9",
    "@sanity/icons": "^5.2.3",
    "@sanity/ui": "^4.4.9",
    "@sanity/vision": "^6.19.0",
    "@superside-oss/sanity-plugin-copy-paste": "^1.0.3",
    "archiver-utils": "^5.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "5.7.0",
    "react-is": "^19.3.1",
    "sanity": "6.19.0",
    "sanity-plugin-media": "^6.3.5",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@sanity/cli": "^8.20.0",
    "@sanity/eslint-config-studio": "^7.0.0",
    "@sanity/prettier-config": "3.0.0",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "baseline-browser-mapping": "2.11.29",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "wrangler": "^4.151.1"
  }
}
