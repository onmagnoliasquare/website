{
  "name": "cms",
  "main": "package.json",
  "version": "0.7.3",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "preview": "wrangler dev dist",
    "build": "sanity build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "run -T vitest",
    "test-ci:unit": "run -T vitest run",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "copy-prod-to-dev": "npx sanity dataset export production ./prod_data.tar.gz && npx sanity dataset delete development && npx sanity dataset create development && npx sanity dataset import ./prod_data.tar.gz development --replace ",
    "sanity:typegen": "yarn sanity schema extract && yarn sanity typegen generate"
  },
  "dependencies": {
    "@sanity/cross-dataset-duplicator": "1.5.1",
    "@sanity/icons": "^3.7.4",
    "@sanity/ui": "^3.1.11",
    "@sanity/vision": "^5.10.0",
    "@superside-oss/sanity-plugin-copy-paste": "^1.0.3",
    "archiver-utils": "^5.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.4",
    "sanity": "^5.10.0",
    "sanity-plugin-media": "^4.1.1",
    "styled-components": "^6.3.9"
  },
  "devDependencies": {
    "@sanity/cli": "^5.10.0",
    "@sanity/eslint-config-studio": "^6.0.0",
    "@sanity/prettier-config": "3.0.0",
    "@types/react": "^19.2.14",
    "baseline-browser-mapping": "2.9.19",
    "eslint": "^10.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "wrangler": "^4.68.0"
  }
}
