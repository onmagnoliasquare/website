{
  "name": "cms",
  "main": "package.json",
  "version": "0.7.10",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "preview": "wrangler dev dist",
    "build": "sanity build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "run -T vitest",
    "test-ci:unit": "run -T vitest run",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "copy-prod-to-dev": "npx sanity dataset export production ./prod_data.tar.gz && npx sanity dataset delete development && npx sanity dataset create development && npx sanity dataset import ./prod_data.tar.gz development --replace ",
    "sanity:typegen": "yarn sanity schema extract && yarn sanity typegen generate"
  },
  "dependencies": {
    "@sanity/cross-dataset-duplicator": "2.1.4",
    "@sanity/icons": "^5.2.1",
    "@sanity/ui": "^4.0.7",
    "@sanity/vision": "^6.11.0",
    "@superside-oss/sanity-plugin-copy-paste": "^1.0.3",
    "archiver-utils": "^5.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "sanity": "6.11.0",
    "sanity-plugin-media": "^6.1.7",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@sanity/cli": "^8.4.2",
    "@sanity/eslint-config-studio": "^7.0.0",
    "@sanity/prettier-config": "3.0.0",
    "@types/node": "26.4.0",
    "@types/react": "^19.2.18",
    "baseline-browser-mapping": "2.11.19",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "wrangler": "^4.127.0"
  }
}
