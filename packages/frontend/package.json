{
  "name": "frontend",
  "type": "module",
  "version": "0.7.10",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:development": "vite build --mode development",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "wrangler dev",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "test": "yarn test:unit && yarn test:integration",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:no-sync": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint --cache .",
    "format": "prettier --plugin-search-dir . --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest run unit",
    "test-ci:integration": "playwright test integration",
    "test-ci:e2e": "playwright test e2e",
    "test-ci:functional": "playwright test functional",
    "test-ci:unit": "vitest run unit",
    "test-ci:components": "vitest run components",
    "test:ci": "vitest run",
    "test:ci-no-pool": "vitest run --pool forks --poolOptions.forks.singleFork",
    "test:ui": "playwright test --ui .",
    "test-ci:production": "playwright test --project=production",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@portabletext/svelte": "^4.0.0",
    "@sanity/client": "^8.4.0",
    "@sanity/image-url": "^2.1.1",
    "@unpic/placeholder": "^0.1.2",
    "@unpic/svelte": "^1.0.1",
    "groq": "^6.11.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@sanity/cli": "^8.4.2",
    "@sanity/codegen": "8.0.0",
    "@sanity/types": "6.11.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/enhanced-img": "0.11.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "26.4.0",
    "@typescript/native": "npm:typescript@7",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "super-sitemap": "2.0.6",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "1.8.1",
    "svelte-meta-tags": "^5.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
