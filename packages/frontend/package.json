{
  "name": "frontend",
  "type": "module",
  "version": "0.8.2",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:development": "vite build --mode development",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "wrangler dev",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "test": "yarn test:unit && yarn test:integration",
    "clean:build": "node -e \"const fs = require('fs'); for (const dir of ['.svelte-kit/cloudflare', '.svelte-kit/cloudflare-tmp', '.svelte-kit/output']) if (fs.existsSync(dir)) fs.rmSync(dir, { recursive: true })\"",
    "check": "yarn clean:build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "ci:check": "yarn clean:build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --output machine",
    "check:watch": "yarn clean:build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:no-sync": "yarn clean:build && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest run unit",
    "ci:test:integration": "playwright test integration",
    "ci:test:e2e": "playwright test e2e",
    "ci:test:functional": "playwright test functional",
    "ci:test:performance": "playwright test performance",
    "ci:test:unit": "vitest run unit",
    "ci:test:components": "vitest run components",
    "ci:test:vitest": "vitest run",
    "ci:test-no-pool": "vitest run --pool forks --poolOptions.forks.singleFork",
    "ci:test": "playwright test --ui .",
    "ci:test:production": "playwright test --project=production",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@number-flow/svelte": "0.4.2",
    "@portabletext/svelte": "^4.0.0",
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "@unpic/placeholder": "^0.1.2",
    "@unpic/svelte": "^1.0.1",
    "groq": "^6.17.0",
    "tailwind-merge": "^3.7.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@sanity-labs/eslint-plugin": "1.0.1",
    "@sanity-labs/prettier-plugin-groq": "1.0.1",
    "@sanity/cli": "^8.13.0",
    "@sanity/codegen": "8.1.1",
    "@sanity/types": "6.17.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/enhanced-img": "0.11.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@typescript/native": "npm:typescript@7",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "super-sitemap": "2.0.6",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "1.8.1",
    "svelte-meta-tags": "^5.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  }
}
