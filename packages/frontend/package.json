{
  "name": "frontend",
  "type": "module",
  "version": "0.7.9",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:development": "vite build --mode development",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "wrangler dev",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "test": "yarn test:unit && yarn test:integration",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:no-sync": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest run unit",
    "test-ci:integration": "playwright test integration",
    "test-ci:e2e": "playwright test e2e/",
    "test-ci:functional": "playwright test functional",
    "test-ci:unit": "vitest run unit",
    "test-ci:components": "vitest run components",
    "test:ci": "vitest run",
    "test:ci-no-pool": "vitest run --pool forks --poolOptions.forks.singleFork",
    "test:ui": "playwright test --ui .",
    "test-ci:production": "playwright test --project=production",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@portabletext/svelte": "^3.0.1",
    "@sanity/client": "^7.26.0",
    "@sanity/image-url": "^2.1.1",
    "@sveltejs/enhanced-img": "0.10.4",
    "@unpic/placeholder": "^0.1.2",
    "@unpic/svelte": "^1.0.1",
    "groq": "^6.8.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@sanity/cli": "^7.16.0",
    "@sanity/codegen": "8.0.0",
    "@sanity/types": "6.8.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "26.1.2",
    "@typescript/native": "npm:typescript@7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "super-sitemap": "2.0.6",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "svelte-eslint-parser": "1.8.0",
    "svelte-meta-tags": "^5.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
