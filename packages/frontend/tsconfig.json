{
  "extends": ["$app/tsconfig"],
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "module": "preserve",
    "noUnusedLocals": true,
    "types": ["$app/types", "@testing-library/jest-dom", "vitest/globals"]
  },
  "include": ["./**/*", "../../../eslint.config.mjs", "../../../lint-staged.config.mjs"],
  "exclude": [
    "node_modules/**/*",
    ".vscode/",
    "dist/",
    "coverage/",
    ".wrangler/",
    "test-results/",
    "playwright-report/"
  ]
}
